#include <bits/stdc++.h>

using namespace std;

#define usopen(filename) do{freopen(filename".in", "r", stdin); freopen(filename".out", "w", stdout);}while(0);
#define f first
#define s second
#define ll long long

bool cmp(pair<int, int>& a, pair<int, int>& b){
    if (a.s == b.s){
        return a.f < b.f;
    }
    return a.s < b.s;
}

int main(){
    int n, m; cin >> n >> m;
    vector<int> a(n), b(m);
    for (int i = 0; i < n; i++){
        cin >> a[i];
    }
    for (int j = 0; j < m; j++){
        cin >> b[j];
    }
    sort(a.begin(), a.end());
    sort(b.begin(), b.end());
    int ca = 0, cb = 0;
    int ans = 0;
    while (ca < n && cb < m){
        if (a[ca] <= b[cb]){
            ans++;
            ca++, cb++;
        }else{
            cb++;
        }
    }
    cout << ans << endl;
    return 0;
}
