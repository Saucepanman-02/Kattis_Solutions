#include <bits/stdc++.h>

using namespace std;

int main(){
    int n, m; cin >> n >> m;
    vector<int> a(n), b(m);
    for (int i = 0; i < n; i++){
        cin >> a[i];
    }
    for (int j = 0; j < m; j++){
        cin >> b[j];
    }
    sort(a.begin(), a.end());
    sort(b.begin(), b.end());
    int ca = 0, cb = 0;
    int ans = 0;
    while (ca < n && cb < m){
        if (a[ca] <= b[cb]){
            ans++;
            ca++, cb++;
        }else{
            cb++;
        }
    }
    cout << ans << endl;
    return 0;
}
