#include <bits/stdc++.h>

using namespace std;

#define speedup ios_base::sync_with_stdio(false); cin.tie(nullptr); cout.tie(nullptr);
#define usopen(filename) do{freopen(filename".in", "r", stdin); freopen(filename".out", "w", stdout);}while(0);
#define f first
#define s second
#define ll long long
#define db double
#define pii pair<int, int>
#define pdd pair<db, db>
#define vi vector<int>
#define EPS 1e-5

vector<ll> a;
int n; 
db ans = 0;

int solve(int c, pdd u, ll cnt){
    if (c >= n-1){
        return -1;
    }
    if (a[c] >= cnt){
        ans += max(u.f, u.s)*(cnt/2);
        return 1;
    }else{
       if (u.f > u.s){
            swap(u.f, u.s);
       }
       u.s = u.s/2;
       if (solve(c+1, u, 2*(cnt-a[c])) == 1){
            ans += max(u.f, 2*u.s)*(cnt/2);
            return 1;
       }else{
            return -1;
       }
    }
}

int main(){
    speedup 
    cin >> n;
    a.resize(n-1);
    for (int i = 0; i < n-1; i++){
        cin >> a[i];
    }
    pdd u = {pow(2, -0.75), pow(2, -1.25)};
    if (solve(0, u , 2) == -1){
        cout << "impossible" << '\n';
        return 0;
    }
    printf("%.10f\n", ans);
    return 0;
}
