#include <bits/stdc++.h>

using namespace std;

#define usopen(filename) do{freopen(filename".in", "r", stdin); freopen(filename".out", "w", stdout);}while(0);
#define f first
#define s second
#define ll long long

bool cmp(pair<int, int>& a, pair<int, int>& b){
    if (a.s == b.s){
        return a.f < b.f;
    }
    return a.s < b.s;
}

int main(){
    int n, k; cin >> n >> k;
    vector<pair<int, int>> a(n);
    for (int i = 0; i < n; i++){
        cin >> a[i].f >> a[i].s;
        a[i].s++;
    }
    sort(a.begin(), a.end(), cmp);

    multiset<int> s;
    int ans = 0;
    s.insert(a[0].s);
    ans++;
    for (int i = 1; i < n; i++){
        auto it = s.upper_bound(a[i].f);
        if (it == s.begin()){
            if (s.size() < k){
                s.insert(a[i].s); ans++;
            }
        }else{
            it--;
            s.erase(it);
            s.insert(a[i].s); ans++;
        }
    }
    cout << ans << endl;

    return 0;
}
