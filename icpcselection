bool cmp(pii &a, pii &b){
    if (a.s == b.s){
        return a.f > b.f;
    }
    return a.s > b.s;
}

int main(){
    int t; cin >> t;
    while (t--){
    int n; cin >> n;
    vector<int> a(3*n);
    for (int i = 0; i < 3*n; i++){
        cin >> a[i];
    }
    sort(a.begin(), a.end());
    int cl = 0, cr = 3*n-1;
