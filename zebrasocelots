int main(){
    int n; cin >> n;
    ll ans = 0;
    for (int i = 0; i < n; i++) {
        char c; cin >> c;
        if (c == 'O')
            ans += (1LL << (n-1-i));
    }
    cout << ans << endl;
    return 0;
}
